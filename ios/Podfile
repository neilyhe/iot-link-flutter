# Uncomment this line to define a global platform for your project
platform :ios, '13.0'
source 'https://cdn.cocoapods.org/'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks! :linkage => :static
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
    
    # 配置 permission_handler 的权限宏定义
    target.build_configurations.each do |config|
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] ||= [
        '$(inherited)',
        
        ## 启用麦克风权限
        'PERMISSION_MICROPHONE=1',
        'PERMISSION_CAMERA=1',

        ## 如果需要其他权限，可以取消注释
        # 'PERMISSION_PHOTOS=1',
      ]
      
      # 确保 Release 模式下符号不被剥离（特别是 xp2p_sdk）
      if target.name == 'xp2p_sdk'
        config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
        config.build_settings['STRIP_STYLE'] = 'non-global'
        config.build_settings['DEAD_CODE_STRIPPING'] = 'NO'
        config.build_settings['GCC_SYMBOLS_PRIVATE_EXTERN'] = 'NO'
        config.build_settings['KEEP_PRIVATE_EXTERNS'] = 'YES'
        config.build_settings['DEPLOYMENT_POSTPROCESSING'] = 'NO'
      end
    end
  end
  
  # 确保主应用也不剥离符号，并强制链接 TencentENET.framework
  installer.pods_project.build_configurations.each do |config|
    if config.name == 'Release' || config.name == 'Profile'
      config.build_settings['STRIP_INSTALLED_PRODUCT'] = 'NO'
      config.build_settings['DEAD_CODE_STRIPPING'] = 'NO'
    end
  end
  
  # 为 Runner target 添加强制链接 TencentENET 和 SoundTouchiOS framework 的配置
  runner_target = installer.aggregate_targets.find { |target| target.name == 'Runner' }
  if runner_target
    runner_target.xcconfigs.each do |config_name, config_file|
      xcconfig_path = runner_target.xcconfig_path(config_name)
      if xcconfig_path && File.exist?(xcconfig_path)
        xcconfig_content = File.read(xcconfig_path)
        # 添加 force_load 标志（如果还没有）
        unless xcconfig_content.include?('force_load')
          File.open(xcconfig_path, 'a') do |file|
            file.puts "\n// Force load framework symbols for FFI"
            file.puts 'OTHER_LDFLAGS = $(inherited) -force_load "$(PODS_ROOT)/../.symlinks/plugins/xp2p_sdk/ios/Libraries/TencentENET.framework/TencentENET" -force_load "$(PODS_ROOT)/../.symlinks/plugins/xp2p_sdk/ios/Libraries/SoundTouchiOS.framework/SoundTouchiOS"'
          end
        end
      end
    end
  end
end
